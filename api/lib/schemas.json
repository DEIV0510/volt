       "type": "string",
       "maxLength": 500,
       "pattern": "^(#[A-Za-z0-9_-]*|https?://[^\\s\"'<>]+|mailto:[^\\s\"'<>]+|tel:[+0-9 ()-]+)$",
       "minLength": 1
