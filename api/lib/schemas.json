 "general": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "name": {
    "type": "string",
    "maxLength": 60,
    "minLength": 1
   },
   "tagline": {
    "type": "string",
    "maxLength": 120
   },
   "whatsapp": {
    "type": "string",
    "maxLength": 15,
    "pattern": "^[0-9]{8,15}$",
    "minLength": 1
   },
   "whatsappDisplay": {
    "type": "string",
    "maxLength": 30
   },
   "whatsappMessage": {
