   },
   "phone": {
    "type": "string",
    "maxLength": 30
   },
   "email": {
    "type": "string",
    "maxLength": 120,
    "pattern": "^$|^[^\\s@<>\"']+@[^\\s@<>\"']+\\.[^\\s@<>\"']+$"
   },
   "address": {
    "type": "string",
    "maxLength": 160
   },
   "hours": {
    "type": "string",
    "maxLength": 160
   },
   "mapUrl": {
    "type": "string",
    "maxLength": 500,
    "pattern": "^$|^(#[A-Za-z0-9_-]*|https?://[^\\s\"'<>]+|mailto:[^\\s\"'<>]+|tel:[+0-9 ()-]+)$"
   },
   "socials": {
    "type": "array",
    "maxItems": 8,
