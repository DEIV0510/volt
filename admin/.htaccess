# Panel de administración: política de seguridad más estricta, sin indexar y sin caché.
# (Mantener igual que el <meta http-equiv="Content-Security-Policy"> de admin/index.html.)
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Cache-Control "no-store"
</IfModule>
