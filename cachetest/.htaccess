# Carpeta temporal: prueba si el servidor acepta la caché larga solo para archivos con ?v=
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (^|&)v=[0-9a-z]+(&|$)
  RewriteRule ^t\.css$ - [E=VOLT_ASSET:1]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.css$">
    Header set Cache-Control "no-cache"
    Header set Cache-Control "public, max-age=31536000, immutable" env=VOLT_ASSET
  </FilesMatch>
</IfModule>
